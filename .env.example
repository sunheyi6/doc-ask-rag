# ========== 必填配置 ==========
DASHSCOPE_API_KEY=your_api_key_here

# ========== 模型配置 ==========
# LLM_MODEL=qwen-turbo
# EMBEDDING_MODEL=text-embedding-v1

# ========== 文本分块 ==========
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100

# ========== 检索配置 ==========
# RETRIEVAL_TOP_K=5
# SIMILARITY_THRESHOLD=1.8

# ========== 混合检索配置（向量语义 + BM25 关键词）==========
# 设为 false 可对比“纯向量检索 vs 混合检索”的效果差异
# ENABLE_HYBRID_RETRIEVAL=true
# RRF 融合常数（论文推荐经验值 60）
# HYBRID_FUSION_K=60

# ========== 路径配置 ==========
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_TEMP_DIR=./chroma_db_temp
# UPLOAD_DIR=./uploaded_docs
# 内置示例文档目录（首次启动自动导入，可删除后不再出现）
# SAMPLE_DOCS_DIR=./src/rag_agent/data/sample_docs
# 内置示例向量库缓存目录（文档未变时直接复用，秒开）
# SAMPLE_KB_DIR=./chroma_db/samples

# ========== 日志配置 ==========
# LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log